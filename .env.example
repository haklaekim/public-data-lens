# docker compose용 환경변수 — 이 파일을 .env로 복사해 값 입력 (.env는 커밋 금지)

## 로컬 풀스택(docker-compose.yml — 웹 포함)용
ANTHROPIC_API_KEY=
# 공개 배포 시 웹 도메인으로 제한 (쉼표 구분). 예: https://datanav.example
DATANAV_CORS_ORIGINS=*
DATANAV_RATE_LIMIT_PER_MIN=120

## 공개 배포(docker-compose.prod.yml — MCP 전용)용
# 게이트웨이 노출 포트 (LB가 이 포트로 전달)
GATEWAY_PORT=8088
# TLS를 종단하는 LB/프록시의 내부 대역(CIDR 1개) — 반드시 지정해야 IP당 제한이 사용자 단위로 동작.
# 예: 10.0.0.0/8 (미지정 시 127.0.0.1 = no-op, LB 뒤에서는 전체 사용자가 한 버킷으로 묶임)
GATEWAY_REAL_IP_FROM=127.0.0.1
# 서비스 도메인(쉼표 구분) — 지정 시 MCP가 Host 헤더를 검증(DNS 리바인딩 보호). 예: data.datahub.kr
DATANAV_MCP_ALLOWED_HOSTS=
# 관측 예시값 공개(S0-2 법적 확인 후 1로) — 기본 비공개. api·mcp 양쪽에 전달된다
DATANAV_EXAMPLES_PUBLIC=0
# §10 익명 사용 로그(1=기록, 0=끔)
DATANAV_USAGE_LOG=1
# 익명 식별자용 HMAC 비밀키(임의 긴 문자열) — 미지정 시 프로세스별 임시 키(재시작마다 회전).
# 재시작을 넘어 일간 활성 지표를 이으려면 지정: openssl rand -hex 32
DATANAV_ANON_HMAC_KEY=
# 월간 빌드 SHACL 검증 표본 수(0=전수)
DATANAV_SHACL_SAMPLE=500

## 생성형 컨시어지 서비스(docker-compose.concierge.yml — 별도 배포)용
# ANTHROPIC_API_KEY 필수(위 공통 항목). 노출 포트:
CONCIERGE_PORT=8890
